{
  "info": {
    "name": "CraftBet API",
    "description": "10 GET requests, one for each data category of the task. Endpoints were found in DevTools (Network tab) on craftbet.com.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// checks for every request",
          "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
          "pm.test(\"Response time is less than 3s\", () => pm.expect(pm.response.responseTime).to.be.below(3000));",
          "pm.test(\"Response is JSON\", () => pm.response.to.be.json);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Account Status",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// client data needs token of logged in user (see README)",
              "if (!pm.environment.get(\"token\")) {",
              "    console.log(\"token is empty, request skipped\");",
              "    pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "    const json = pm.response.json();",
              "    pm.test(\"ResponseCode is 0\", () => pm.expect(json.ResponseCode, json.Description).to.eql(0));",
              "    pm.test(\"Account is found by token\", () => pm.expect(json.Id).to.be.above(0));",
              "    pm.test(\"Account has currency and verification status\", () => {",
              "        pm.expect(json.CurrencyId).to.be.a(\"string\").and.not.empty;",
              "        pm.expect(json.IsEmailVerified).to.be.a(\"boolean\");",
              "    });",
              "    if (json.Id > 0) {",
              "        // saved for next requests",
              "        pm.environment.set(\"clientId\", json.Id);",
              "        pm.environment.set(\"currencyId\", json.CurrencyId);",
              "        // server gives a new session token here, the old one stops working (the site does the same)",
              "        if (json.Token) {",
              "            pm.environment.set(\"token\", json.Token);",
              "        }",
              "    } else {",
              "        pm.environment.set(\"token\", \"\");  // wrong token - other requests will be skipped",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{siteUrl}}"
          },
          {
            "key": "Referer",
            "value": "{{siteUrl}}/"
          }
        ],
        "url": {
          "raw": "{{webApi}}/1/api/Main/GetClientByToken",
          "host": [
            "{{webApi}}"
          ],
          "path": [
            "1",
            "api",
            "Main",
            "GetClientByToken"
          ]
        },
        "description": "Account status and details by token. Run first: saves clientId and currencyId.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"LanguageId\": \"{{languageId}}\",\n  \"Token\": \"{{token}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      }
    },
